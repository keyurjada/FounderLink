{
  "name": "founderlink-workspace",
  "version": "1.0.0",
  "description": "FounderLink - Startup Co-Founder Matching Platform monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev-backend": "npm run dev --workspace=backend",
    "dev-frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
